import java.util.*;
import java.util.function.*;

// 1. PROCESS DATA MODEL
class Process {
    int id, at, bt, prio, rem, ct, tat, wt;
    Process(int id, int at, int bt, int prio) {
        this.id = id; this.at = at; this.bt = bt; this.prio = prio; this.rem = bt;
    }
}

public class Main {
    // 2. LOG 1 CPU TICK & CALCULATE METRICS ON FINISH
    static int tick(Process c, int t, List<String> log) {
        log.add(c == null ? "Idle" : "P" + c.id);
        if (c == null || --c.rem > 0) return 0;
        c.ct = t + 1; c.tat = c.ct - c.at; c.wt = c.tat - c.bt;
        return 1;
    }

    // 3. PRINT GANTT CHART, TABLE, AVERAGES & RESET FOR NEXT ALGORITHM
    static void print(List<Process> list, String title, List<String> log) {
        String gantt = "";
        for (int t = 0; t < log.size(); t++)
            if (t == 0 || !log.get(t).equals(log.get(t - 1))) gantt += "(" + t + ") | " + log.get(t) + " | ";
        int time = log.size(), n = list.size();
        double wt = 0, tat = 0, bt = 0;
        System.out.println("\n=== " + title + " ===\nGantt Chart: " + gantt + "(" + time + ")\nID\tAT\tBT\tPrio\tCT\tTAT\tWT");
        for (Process p : list) {
            bt += p.bt; tat += p.tat; wt += p.wt; p.rem = p.bt; // auto-resets rem
            System.out.printf("P%d\t%d\t%d\t%d\t%d\t%d\t%d\n", p.id, p.at, p.bt, p.prio, p.ct, p.tat, p.wt);
        }
        System.out.printf("Avg WT : %.0f / %d = %.2f\nAvg TAT: %.0f / %d = %.2f\nCPU Utilization: (%.0f / %d) * 100 = %.2f%%\n",
            wt, n, wt / n, tat, n, tat / n, bt, time, (bt / time) * 100);
    }

    // 4. UNIFIED SOLVER: FCFS, SJF, SRTF, PREEMPTIVE PRIORITY (PP)
    static void solve(List<Process> list, String title, Predicate<Process> lock, Comparator<Process> cmp) {
        List<String> log = new ArrayList<>();
        Process cur = null;
        for (int t = 0, done = 0; done < list.size(); t++) {
            int now = t;
            if (cur == null || !lock.test(cur))
                cur = list.stream().filter(p -> p.at <= now && p.rem > 0)
                          .min(cmp.thenComparingInt(p -> p.at)).orElse(null);
            if (tick(cur, t, log) == 1) { done++; cur = null; }
        }
        print(list, title, log);
    }

    // 5. ROUND ROBIN (RR)
    static void roundRobin(List<Process> list, int q) {
        List<String> log = new ArrayList<>();
        Queue<Process> rq = new LinkedList<>();
        Process cur = null;
        for (int t = 0, done = 0, qt = 0; done < list.size(); t++, qt++) {
            for (Process p : list) if (p.at == t) rq.add(p);
            if (cur != null && qt == q) { rq.add(cur); cur = null; }
            if (cur == null && !rq.isEmpty()) { cur = rq.poll(); qt = 0; }
            if (tick(cur, t, log) == 1) { done++; cur = null; }
        }
        print(list, "Round Robin (RR, Q=" + q + ")", log);
    }

    // 6. 3-LEVEL MULTILEVEL QUEUE: Q1 (prio 1) = RR, Q2 (prio 2) = SJF, Q3 (prio >= 3) = FCFS
    static void multilevel(List<Process> list, int q) {
        List<String> log = new ArrayList<>();
        Queue<Process> q1 = new LinkedList<>();
        Process cur = null;
        for (int t = 0, done = 0, qt = 0; done < list.size(); t++) {
            for (Process p : list) if (p.at == t && p.prio == 1) q1.add(p);
            if (cur != null && cur.prio == 1 && qt == q) { q1.add(cur); cur = null; }
            if (!q1.isEmpty() && cur != null && cur.prio > 1) cur = null; // Q1 preempts Q2 & Q3

            if (cur == null) {
                if (!q1.isEmpty()) { cur = q1.poll(); qt = 0; }
                else {
                    int now = t;
                    // Q2: SJF (shortest burst time)
                    cur = list.stream().filter(p -> p.at <= now && p.rem > 0 && p.prio == 2)
                              .min(Comparator.comparingInt((Process p) -> p.bt).thenComparingInt(p -> p.at)).orElse(null);
                    // Q3: FCFS (earliest arrival time)
                    if (cur == null) cur = list.stream().filter(p -> p.at <= now && p.rem > 0 && p.prio >= 3)
                              .min(Comparator.comparingInt(p -> p.at)).orElse(null);
                }
            }
            if (cur != null && cur.prio == 1) qt++;
            if (tick(cur, t, log) == 1) { done++; cur = null; }
        }
        print(list, "Multilevel Queue (Q1: RR(Q=" + q + "), Q2: SJF, Q3: FCFS)", log);
    }

    // 7. MAIN: RUNS ALL ALGORITHMS
    public static void main(String[] args) {
        List<Process> list = Arrays.asList(
            new Process(1, 0, 8, 2),
            new Process(2, 1, 4, 1),
            new Process(3, 2, 9, 3),
            new Process(4, 3, 5, 2)
        );

        solve(list, "FCFS", p -> true, Comparator.comparingInt(p -> p.at));
        solve(list, "SJF (Non-Preemptive)", p -> true, Comparator.comparingInt(p -> p.bt));
        solve(list, "SRTF (Shortest Remaining Time First)", p -> false, Comparator.comparingInt(p -> p.rem));
        solve(list, "Preemptive Priority (PP)", p -> false, Comparator.comparingInt(p -> p.prio));
        roundRobin(list, 3);
        multilevel(list, 2);
    }
}
