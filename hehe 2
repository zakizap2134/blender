// 7. ROUND ROBIN CLASS
class RoundRobin {
    void solve(List<Process> list, int q) {
        List<String> log = new ArrayList<>();
        Queue<Process> rq = new LinkedList<>();
        Process cur = null;
        for (int t = 0, done = 0, qt = 0; done < list.size(); t++, qt++) {
            for (Process p : list) if (p.at == t) rq.add(p);
            if (cur != null && qt == q) { rq.add(cur); cur = null; }
            if (cur == null && !rq.isEmpty()) { cur = rq.poll(); qt = 0; }
            if (Process.tick(cur, t, log) == 1) { done++; cur = null; }
        }
        Process.print(list, "Round Robin (Q=" + q + ")", log);
    }
}

// 8. MULTILEVEL QUEUE CLASS (Q1: RR, Q2: SRTF, Q3: Priority, Q4: SJF, Q5: FCFS)
class Multilevel {
    void solve(List<Process> list, int q) {
        List<String> log = new ArrayList<>();
        Queue<Process> q1 = new LinkedList<>();
        Process cur = null;

        for (int t = 0, done = 0, qt = 0; done < list.size(); t++) {
            int now = t;

            // 1. Add arrivals to Queue 1 (prio 1)
            for (Process p : list) if (p.at == t && p.prio == 1) q1.add(p);

            // RR time slice expiration
            if (cur != null && cur.prio == 1 && qt == q) { q1.add(cur); cur = null; }

            // Inter-queue Preemption: higher queue preempts lower queue
            int curPrio = (cur == null) ? Integer.MAX_VALUE : cur.prio;
            boolean higherReady = (!q1.isEmpty() && curPrio > 1)
                || list.stream().anyMatch(p -> p.at <= now && p.rem > 0 && p.prio < curPrio);
            if (higherReady) cur = null;

            // Intra-queue Preemption for Queue 2 (SRTF): shorter remaining time preempts current Q2 process
            if (cur != null && cur.prio == 2) {
                boolean shorterQ2 = list.stream().anyMatch(p -> p.at <= now && p.rem > 0 && p.prio == 2 && p.rem < cur.rem);
                if (shorterQ2) cur = null;
            }

            // 2. Queue Selection by Level (Q1 -> Q2 -> Q3 -> Q4 -> Q5)
            if (cur == null) {
                if (!q1.isEmpty()) {
                    cur = q1.poll();
                    qt = 0;
                } else {
                    // Queue 2 (prio 2): SRTF (Shortest Remaining Time)
                    cur = list.stream().filter(p -> p.at <= now && p.rem > 0 && p.prio == 2)
                              .min(Comparator.comparingInt((Process p) -> p.rem).thenComparingInt(p -> p.at)).orElse(null);

                    // Queue 3 (prio 3): Priority Scheduling
                    if (cur == null)
                        cur = list.stream().filter(p -> p.at <= now && p.rem > 0 && p.prio == 3)
                                  .min(Comparator.comparingInt((Process p) -> p.at)).orElse(null);

                    // Queue 4 (prio 4): SJF (Shortest Burst Time)
                    if (cur == null)
                        cur = list.stream().filter(p -> p.at <= now && p.rem > 0 && p.prio == 4)
                                  .min(Comparator.comparingInt((Process p) -> p.bt).thenComparingInt(p -> p.at)).orElse(null);

                    // Queue 5 (prio >= 5): FCFS (First-Come First-Served)
                    if (cur == null)
                        cur = list.stream().filter(p -> p.at <= now && p.rem > 0 && p.prio >= 5)
                                  .min(Comparator.comparingInt(p -> p.at)).orElse(null);
                }
            }

            if (cur != null && cur.prio == 1) qt++;
            if (Process.tick(cur, t, log) == 1) { done++; cur = null; }
        }
        Process.print(list, "Multilevel Queue (Q1: RR[Q=" + q + "], Q2: SRTF, Q3: Prio, Q4: SJF, Q5: FCFS)", log);
    }
}

// 9. MAIN CLASS WITH SCANNER
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter number of processes: ");
        int n = sc.nextInt();
        List<Process> list = new ArrayList<>();

        System.out.println("Enter process details (ID AT BT Priority [enter 0 if no priority]):");
        for (int i = 0; i < n; i++) {
            System.out.printf("Process %d (e.g., P%d 0 5 1): ", i + 1, i + 1);
            String id = sc.next();
            int at = sc.nextInt();
            int bt = sc.nextInt();
            int prio = sc.nextInt();
            list.add(new Process(id, at, bt, prio));
        }

        System.out.print("Enter Time Quantum (for Round Robin & Multilevel): ");
        int q = sc.nextInt();

        System.out.println("\nSelect Algorithm:");
        System.out.println("1. FCFS");
        System.out.println("2. SJF (Non-Preemptive)");
        System.out.println("3. SRTF (Preemptive SJF)");
        System.out.println("4. Non-Preemptive Priority");
        System.out.println("5. Preemptive Priority");
        System.out.println("6. Round Robin");
        System.out.println("7. Multilevel Queue (Q1: RR, Q2: SRTF, Q3: Prio, Q4: SJF, Q5: FCFS)");
        System.out.println("8. Run ALL Algorithms");
        System.out.print("Enter choice (1-8): ");
        int choice = sc.nextInt();

        if (choice == 1 || choice == 8) new FCFS().solve(list);
        if (choice == 2 || choice == 8) new SJF().solve(list);
        if (choice == 3 || choice == 8) new SRTF().solve(list);
        if (choice == 4 || choice == 8) new PriorityNonPreemptive().solve(list);
        if (choice == 5 || choice == 8) new PriorityPreemptive().solve(list);
        if (choice == 6 || choice == 8) new RoundRobin().solve(list, q);
        if (choice == 7 || choice == 8) new Multilevel().solve(list, q);

        sc.close();
    }
}
