import java.util.*;

// 1. PROCESS DATA & SHARED HELPERS
class Process {
    static String IDLE = "Idle"; // Change idle label anytime (e.g. "Idle", "IDLE", "---")

    String id;
    int at, bt, prio, queue, rem, ct, tat, wt;

    // With Priority & Queue (each ID can be given its own queue)
    Process(String id, int at, int bt, int prio, int queue) {
        this.id = id; this.at = at; this.bt = bt; this.prio = prio; this.queue = queue; this.rem = bt;
    }
    Process(int id, int at, int bt, int prio, int queue) { this("P" + id, at, bt, prio, queue); }

    // With Priority (for Priority & Multilevel)
    Process(String id, int at, int bt, int prio) { this(id, at, bt, prio, 0); }
    Process(int id, int at, int bt, int prio) { this("P" + id, at, bt, prio, 0); }

    // Without Priority (for FCFS, SJF, SRTF, Round Robin)
    Process(String id, int at, int bt) { this(id, at, bt, 0, 0); }
    Process(int id, int at, int bt) { this("P" + id, at, bt, 0, 0); }

    // Logs 1 tick of CPU time; returns 1 if process finishes, 0 otherwise
    static int tick(Process c, int t, List<String> log) {
        log.add(c == null ? IDLE : c.id);
        if (c == null || --c.rem > 0) return 0;
        c.ct = t + 1; c.tat = c.ct - c.at; c.wt = c.tat - c.bt;
        return 1;
    }

    // Prints Gantt chart, table, averages, Idle Time, CPU utilization, and resets rem
    static void print(List<Process> list, String title, List<String> log) {
        print(list, title, log, null);
    }

    static void print(List<Process> list, String title, List<String> log, String[] order) {
        String gantt = "";
        int time = log.size(), n = list.size();
        for (int t = 0, start = 0; t < time; t++) {
            String id = log.get(t);
            int rem = -1;
            for (Process p : list) if (p.id.equals(id)) rem = p.bt - ++p.rem;
            if (t == time - 1 || !id.equals(log.get(t + 1))) {
                gantt += "(" + start + ") | " + id + (rem >= 0 ? "(rem=" + rem + ")" : "") + " | ";
                start = t + 1;
            }
        }

        double wt = 0, tat = 0, bt = 0;
        boolean hasPrio = list.stream().anyMatch(p -> p.prio != 0);

        System.out.println("\n=== " + title + " ===\nGantt Chart: " + gantt + "(" + time + ")");
        System.out.println("ID\tAT\tBT" + (hasPrio ? "\tPrio" : "") + (order != null ? "\tQueue" : "") + "\tCT\tTAT\tWT");
        for (Process p : list) {
            bt += p.bt; tat += p.tat; wt += p.wt; p.rem = p.bt; // Auto-reset rem for next algorithm
            System.out.println(p.id + "\t" + p.at + "\t" + p.bt
                + (hasPrio ? "\t" + p.prio : "")
                + (order != null ? "\tQ" + Multilevel.qLevel(p, order.length) : "")
                + "\t" + p.ct + "\t" + p.tat + "\t" + p.wt);
        }

        int idle = time - (int) bt;
        System.out.printf("Avg WT : %.0f / %d = %.2f\nAvg TAT: %.0f / %d = %.2f\nIdle Time: %d | CPU Utilization: (%.0f / %d) * 100 = %.2f%%\n",
            wt, n, wt / n, tat, n, tat / n, idle, bt, time, (bt / time) * 100);
    }
}

// 2. FCFS CLASS
class FCFS {
    void solve(List<Process> list) {
        List<String> log = new ArrayList<>();
        Process cur = null;
        for (int t = 0, done = 0; done < list.size(); t++) {
            int now = t;
            if (cur == null)
                cur = list.stream().filter(p -> p.at <= now && p.rem > 0)
                          .min(Comparator.comparingInt(p -> p.at)).orElse(null);
            if (Process.tick(cur, t, log) == 1) { done++; cur = null; }
        }
        Process.print(list, "FCFS", log);
    }
}

// 3. SJF CLASS (Non-Preemptive)
class SJF {
    void solve(List<Process> list) {
        List<String> log = new ArrayList<>();
        Process cur = null;
        for (int t = 0, done = 0; done < list.size(); t++) {
            int now = t;
            if (cur == null)
                cur = list.stream().filter(p -> p.at <= now && p.rem > 0)
                          .min(Comparator.comparingInt((Process p) -> p.bt).thenComparingInt(p -> p.at)).orElse(null);
            if (Process.tick(cur, t, log) == 1) { done++; cur = null; }
        }
        Process.print(list, "SJF (Non-Preemptive)", log);
    }
}

