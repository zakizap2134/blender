// 7. ROUND ROBIN CLASS
class RoundRobin {
    void solve(List<Process> list, int q) {
        List<String> log = new ArrayList<>();
        Queue<Process> rq = new LinkedList<>();
        Process cur = null;
        for (int t = 0, done = 0, qt = 0; done < list.size(); t++, qt++) {
            for (Process p : list) if (p.at == t) rq.add(p);
            if (cur != null && qt == q) { rq.add(cur); cur = null; }
            if (cur == null && !rq.isEmpty()) { cur = rq.poll(); qt = 0; }
            if (Process.tick(cur, t, log) == 1) { done++; cur = null; }
        }
        Process.print(list, "Round Robin (Q=" + q + ")", log);
    }
}

// 8. MULTILEVEL QUEUE CLASS (Pass any queue order in main: "FCFS", "SJF", "SRTF", "RR", "PP", "NPP")
class Multilevel {
    void solve(List<Process> list, int q) {
        solve(list, q, "RR", "SRTF", "SJF", "FCFS"); // Default order
    }

    void solve(List<Process> list, int q, String... order) {
        if (order.length == 0) order = new String[]{"RR", "SRTF", "SJF", "FCFS"};
        int levels = order.length;
        List<String> log = new ArrayList<>();
        List<Queue<Process>> rr = new ArrayList<>();
        for (int i = 0; i <= levels; i++) rr.add(new LinkedList<>());
        Process cur = null;

        for (int t = 0, done = 0, qt = 0; done < list.size(); t++) {
            int now = t;

            // 1. Add arrivals to their RR queue (for any queue configured as "RR")
            for (Process p : list) {
                int ql = qLevel(p, levels);
                if (p.at == t && order[ql - 1].equalsIgnoreCase("RR")) rr.get(ql).add(p);
            }

            // 2. RR time slice expiration
            if (cur != null) {
                int curQ = qLevel(cur, levels);
                if (order[curQ - 1].equalsIgnoreCase("RR") && qt == q) {
                    rr.get(curQ).add(cur);
                    cur = null;
                }
            }

            // 3. Inter-queue Preemption: higher queue (smaller qLevel) preempts lower queue
            int curQ = (cur == null) ? Integer.MAX_VALUE : qLevel(cur, levels);
            boolean higherReady = list.stream().anyMatch(p -> p.at <= now && p.rem > 0 && qLevel(p, levels) < curQ);
            if (higherReady) {
                if (cur != null && order[curQ - 1].equalsIgnoreCase("RR")) rr.get(curQ).add(cur);
                cur = null;
            }

            // 4. Intra-queue Preemption for SRTF or PP
            if (cur != null) {
                int qIdx = qLevel(cur, levels);
                String algo = order[qIdx - 1].toUpperCase();
                if (algo.equals("SRTF")) {
                    int curRem = cur.rem;
                    if (list.stream().anyMatch(p -> p.at <= now && p.rem > 0 && qLevel(p, levels) == qIdx && p.rem < curRem))
                        cur = null;
                } else if (algo.equals("PP")) {
                    int curPrio = cur.prio;
                    if (list.stream().anyMatch(p -> p.at <= now && p.rem > 0 && qLevel(p, levels) == qIdx && p.prio < curPrio))
                        cur = null;
                }
            }

            // 5. Queue Selection (picks highest ready queue priority first)
            if (cur == null) {
                int bestQ = list.stream().filter(p -> p.at <= now && p.rem > 0)
                                .mapToInt(p -> qLevel(p, levels)).min().orElse(-1);
                if (bestQ != -1) {
                    String algo = order[bestQ - 1].toUpperCase();
                    if (algo.equals("RR")) {
                        cur = rr.get(bestQ).poll();
                        qt = 0;
                    } else if (algo.equals("SRTF")) {
                        cur = list.stream().filter(p -> p.at <= now && p.rem > 0 && qLevel(p, levels) == bestQ)
                                  .min(Comparator.comparingInt((Process p) -> p.rem).thenComparingInt(p -> p.at)).orElse(null);
                    } else if (algo.equals("SJF")) {
                        cur = list.stream().filter(p -> p.at <= now && p.rem > 0 && qLevel(p, levels) == bestQ)
                                  .min(Comparator.comparingInt((Process p) -> p.bt).thenComparingInt(p -> p.at)).orElse(null);
                    } else if (algo.equals("PP") || algo.equals("NPP")) {
                        cur = list.stream().filter(p -> p.at <= now && p.rem > 0 && qLevel(p, levels) == bestQ)
                                  .min(Comparator.comparingInt((Process p) -> p.prio).thenComparingInt(p -> p.at)).orElse(null);
                    } else { // FCFS
                        cur = list.stream().filter(p -> p.at <= now && p.rem > 0 && qLevel(p, levels) == bestQ)
                                  .min(Comparator.comparingInt(p -> p.at)).orElse(null);
                    }
                }
            }

            if (cur != null && order[qLevel(cur, levels) - 1].equalsIgnoreCase("RR")) qt++;
            if (Process.tick(cur, t, log) == 1) { done++; cur = null; }
        }
        Process.print(list, "Multilevel Queue " + Arrays.toString(order) + " (Q=" + q + ")", log, order);
    }

    static int qLevel(Process p, int levels) {
        int q = p.queue > 0 ? p.queue : p.prio;
        return q <= 0 ? levels : Math.min(q, levels);
    }
}

// 9. MAIN CLASS (NO SCANNER - HARDCODED PROCESSES)
public class Main {
    public static void main(String[] args) {
        Process.IDLE = "Idle"; // Change idle text in Gantt chart (e.g. "Idle", "IDLE", "---")

        // Define processes (ID, AT, BT, Prio) or (ID, AT, BT, Prio, Queue):
        // (Includes gaps before t=2 and at t=8..10 so Idle time shows in Gantt chart)
        List<Process> list = Arrays.asList(
            new Process("A",   2, 4, 3),
            new Process("B",   3, 2, 1),
            new Process(3,    10, 5, 4), // displays as "P3"
            new Process("P4", 11, 3, 2)
        );

        int q = 3; // Time quantum for Round Robin & Multilevel

        // Directly call whichever algorithms you want (comment out any you don't need):
        new FCFS().solve(list);
        new SJF().solve(list);
        new SRTF().solve(list);
        new PriorityNonPreemptive().solve(list);
        new PriorityPreemptive().solve(list);
        new RoundRobin().solve(list, q);

        // Quick change: reorder queue names ("FCFS", "SJF", "SRTF", "RR", "PP", "NPP"):
        new Multilevel().solve(list, 2, "FCFS", "SJF", "SRTF", "RR");
    }
}
